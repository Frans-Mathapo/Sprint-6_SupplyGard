	column 'Long Distance Score' =
			
			IF(
			    deliveries[delivery_distance_km] > 509.70,
			    15,
			    0
			)
		formatString: 0
		lineageTag: e78c32f6-0ff9-404b-aa50-ab8ab6acdae1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Long Duration Score' =
			
			IF(
			    deliveries[delivery_duration_hours] > 9.02,
			    20,
			    0
			)
		formatString: 0
		lineageTag: e59b2760-3f0b-41aa-8bda-73fc7effab39
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'High Risk Route Score' =
			
			IF(
			    [Long Distance Score] = 15 &&
			    [Long Duration Score] = 20,
			    20,
			    0
			)
		formatString: 0
		lineageTag: 2d3dab3e-ab76-4563-8c81-768a5c50d053
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

