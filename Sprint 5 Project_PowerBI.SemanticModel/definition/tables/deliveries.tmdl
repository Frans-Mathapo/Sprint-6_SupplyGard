table deliveries
	lineageTag: 8bd2bc56-52ea-46e0-8bc8-d1ab7dd97797

	measure 'Distance 75th Percentile' =
			
			PERCENTILEX.INC(
			    deliveries,
			    deliveries[delivery_distance_km],
			    0.75
			)
		lineageTag: bc863ef1-129a-4960-bc66-23e60270104c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Deliveries' =
			
			CALCULATE(
			    COUNTROWS(delivery_labels),
			    delivery_labels[is_late] = 1
			)
		formatString: 0
		lineageTag: 0b165fd3-7926-4cbc-8794-c65d2f95909a

	measure 'Duration 75th Percentile' =
			
			PERCENTILEX.INC(
			    deliveries,
			    deliveries[delivery_duration_hours],
			    0.75
			)
		lineageTag: d490f9ad-ace7-4921-b665-251bd9895a34

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Repeated Customer Delay Score' =
			
			IF(
			    [Late Deliveries] >= 2,
			    20,
			    0
			)
		formatString: 0
		lineageTag: 57239d3e-fab5-464f-af7f-9b2fac4e6bba

	measure 'Operational Risk Score' =
			
			MAX(delivery_labels[Late Delivery Score]) +
			MAX(deliveries[Long Distance Score]) +
			MAX(deliveries[Long Duration Score]) +
			MAX(deliveries[High Risk Route Score]) +
			[Repeated Customer Delay Score]
		formatString: 0
		lineageTag: 5e926a71-5d64-4039-862d-a95bc2a0f7ef

	measure 'Risk Category' =
			
			VAR Score = [Operational Risk Score]
			
			RETURN
			SWITCH(
			    TRUE(),
			    Score <= 30, "Low Risk",
			    Score <= 60, "Medium Risk",
			    Score <= 100, "High Risk",
			    "Check Score"
			)
		lineageTag: 0c0c070f-8502-43c3-b6df-57f06fb36b3b

